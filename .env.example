# Copy this file to .env and fill in the values before running the server
PORT=3000
DEST_EMAIL=jp.childishwebcare@gmail.com

# Canonical host for the live site. When set, the server 301-redirects any
# other public host (e.g. the bare apex navarrewebcare.com) to this one and
# upgrades http:// to https://. Leave blank for local dev.
# CANONICAL_HOST=www.navarrewebcare.com

# Number of reverse proxies in front of the app (X-Forwarded-For hops).
# Railway alone = 1 (default). Cloudflare proxy -> Railway = 2. Getting this
# wrong makes the contact-form rate limiter throttle the proxy's IP instead
# of real visitors.
# TRUST_PROXY_HOPS=2

# SMTP server settings (example: smtp..com)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: override the From header
FROM_EMAIL=

# --- Security (security/) ---------------------------------------------------
# Salt used to hash client IPs before they ever touch memory or logs (rate
# limiter keys, honeypot strike tracking). Set a long random value in
# Railway; the fallback in security/hash.js is dev-only.
# SECURITY_SALT=

# Global rate limit: max requests per hashed client per minute.
# RATE_LIMIT_MAX=120

# Honeypot: strikes on a trap path before a client is blocked, and how
# long the block lasts (ms).
# HONEYPOT_STRIKE_LIMIT=1
# HONEYPOT_BLOCK_MS=86400000
