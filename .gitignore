# Dependencies
node_modules/

# Environment / secrets — never commit
.env
.env.*
!.env.example
# Deliberate exception: the honeypot decoy. Contains only FAKE credentials
# and is meant to be committed — it's bait both for path scanners hitting
# /.env (see security/honeypot.js) and for anyone who gets hold of the repo.
!.env.backup

